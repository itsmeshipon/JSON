    "tag": [
      {
        "accountId": "0",
        "containerId": "0",
        "tagId": "1",
        "name": "cHTML - Omega Web Quoter listener -> dataLayer",
        "type": "html",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n/*\n * Resilient Auto Glass: Omega EDI Web Quoter -> dataLayer bridge (GTM-only)\n * The quoter runs in a cross-origin iframe (resilient.omegaedi.com) and postMessages JSON\n * strings to the parent page, e.g. {\"event\":\"click\",\"lead_stage\":\"QuoteRequested\",\"lead_email\":\"...\"}\n * (payload keys taken from the live GTM-T8S9RCFV v19 setup; confirm once in Preview).\n * This listener:\n *   - accepts messages only from *.omegaedi.com (the old listener had no origin check),\n *   - pushes omega_lead_stage once per new lead_stage (funnel / future conversions),\n *   - pushes quote_request_success ONCE per lead when lead_stage reaches QuoteRequested,\n *     with user_data for Enhanced Conversions. Later clicks in the quoter (scheduling etc.)\n *     still carry lead_stage=QuoteRequested, so the dedup guard matters.\n * Fire on: Initialization - All Pages.\n */\n(function () {\n  if (window.__ragOmegaListener) return;\n  window.__ragOmegaListener = true;\n\n  var ORIGIN_RE = /^https:\\/\\/([a-z0-9-]+\\.)*omegaedi\\.com$/i;\n  var SUCCESS_RE = /QuoteRequested/i;\n  var STORE_KEY = 'rag_omega_quote_tracked';\n  var lastStage = '';\n  window.dataLayer = window.dataLayer || [];\n\n  function str(v) { return v == null ? '' : String(v).replace(/^\\s+|\\s+$/g, ''); }\n  function pick(o, keys) {\n    for (var i = 0; i < keys.length; i++) { if (o[keys[i]] != null && str(o[keys[i]]) !== '') return str(o[keys[i]]); }\n    return '';\n  }\n  function email(v) { v = str(v).toLowerCase(); return /^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$/.test(v) ? v : ''; }\n  function phoneE164(p) {\n    p = str(p).replace(/[^\\d+]/g, '');\n    if (!p) return '';\n    if (p.charAt(0) !== '+') {\n      if (p.length === 10) p = '+1' + p;                                   // US default\n      else if (p.length === 11 && p.charAt(0) === '1') p = '+' + p;\n      else return '';\n    }\n    return /^\\+\\d{10,15}$/.test(p) ? p : '';\n  }\n  function key(em) { return em || 'anon'; }\n  function alreadyTracked(k) {\n    try {\n      var s = JSON.parse(sessionStorage.getItem(STORE_KEY) || '{}');\n      if (s[k] && (Date.now() - s[k]) < 30 * 60 * 1000) return true;    // same lead within 30 min\n      s[k] = Date.now();\n      sessionStorage.setItem(STORE_KEY, JSON.stringify(s));\n    } catch (e) {\n      if (window['__ragTracked_' + k]) return true;\n      window['__ragTracked_' + k] = true;\n    }\n    return false;\n  }\n  function formGuid(source) {\n    var frames = document.querySelectorAll('iframe[id^=\"omegaWebQuoter_\"]');\n    for (var i = 0; i < frames.length; i++) {\n      if (frames[i].contentWindow === source) return frames[i].id.replace('omegaWebQuoter_', '');\n    }\n    return frames.length ? frames[0].id.replace('omegaWebQuoter_', '') : '';\n  }\n\n  window.addEventListener('message', function (e) {\n    if (!ORIGIN_RE.test(e.origin || '')) return;\n    var d = e.data;\n    if (typeof d === 'string') { try { d = JSON.parse(d); } catch (err) { return; } }\n    if (!d || typeof d !== 'object') return;\n\n    var stage = pick(d, ['lead_stage', 'leadStage', 'stage']);\n    if (!stage || stage === lastStage) return;\n    lastStage = stage;\n\n    var em = email(pick(d, ['lead_email', 'email']));\n    var ph = phoneE164(pick(d, ['lead_phone', 'lead_phone_number', 'phone', 'phone_number']));\n    var fid = formGuid(e.source);\n\n    window.dataLayer.push({ event: 'omega_lead_stage', lead_stage: stage, form_id: fid, form_provider: 'omega_web_quoter' });\n\n    if (SUCCESS_RE.test(stage) && !alreadyTracked(key(em))) {\n      window.dataLayer.push({ user_data: null });\n      window.dataLayer.push({\n        event: 'quote_request_success',\n        lead_stage: stage,\n        form_id: fid,\n        form_name: 'Get a Quote (Omega Web Quoter)',\n        form_provider: 'omega_web_quoter',\n        event_id: 'quote_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10),\n        user_data: { email: em || undefined, phone_number: ph || undefined }\n      });\n    }\n  }, false);\n})();\n</script>\n"
          },
